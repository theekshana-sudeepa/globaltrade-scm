<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
      PRIMARY CONFIGURATION: WildFly 31+ (Jakarta EE 10 Full Platform) + MySQL 8.

      An alternate, ready-to-use Payara/GlassFish configuration is provided at
      META-INF/alternate-configs/persistence-payara.xml. Switching servers is a
      one-file substitution: every @PersistenceContext in the codebase references
      the persistence-unit name "GlobalTradePU", which both configurations
      preserve unchanged. This is the JPA portability guarantee in concrete form.
    -->
    <persistence-unit name="GlobalTradePU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:/jdbc/globaltrade</jta-data-source>

        <class>lk.jiat.globaltrade.domain.Vendor</class>
        <class>lk.jiat.globaltrade.domain.Shipment</class>
        <class>lk.jiat.globaltrade.domain.InventoryItem</class>
        <class>lk.jiat.globaltrade.domain.CustomsDeclaration</class>
        <class>lk.jiat.globaltrade.domain.AuditLog</class>
        <class>lk.jiat.globaltrade.domain.AppUser</class>
        <class>lk.jiat.globaltrade.domain.RefreshToken</class>
        <class>lk.jiat.globaltrade.domain.VendorPerformance</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <!-- ENABLE_SELECTIVE: only entities annotated @Cacheable are second-level
             cached. Vendor is; Shipment deliberately is not. -->
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <!--
              hbm2ddl.auto = update for this prototype.

              The authoritative schema is the version-controlled DDL in
              database/01-schema.sql, which carries the indexes, CHECK constraints
              and foreign keys the ORM would not generate. "update" is retained
              only as a safety net so a deployment cannot fail on a trivial column
              mismatch during assessment.

              For production the correct value is "validate" (or "none" with a
              Flyway/Liquibase migration step): letting an ORM alter a live
              logistics schema at boot is an outage waiting to happen.
            -->
            <property name="hibernate.hbm2ddl.auto"  value="update"/>
            <property name="hibernate.show_sql"      value="false"/>
            <property name="hibernate.format_sql"    value="true"/>
            <property name="hibernate.generate_statistics" value="true"/>

            <!-- PERFORMANCE TUNING: batch writes for the nightly reconciliation timer.
                 Requires rewriteBatchedStatements=true on the MySQL connection URL,
                 otherwise the driver silently sends the statements one at a time. -->
            <property name="hibernate.jdbc.batch_size"   value="50"/>
            <property name="hibernate.order_inserts"     value="true"/>
            <property name="hibernate.order_updates"     value="true"/>
            <property name="hibernate.jdbc.fetch_size"   value="100"/>

            <!-- Second-level cache for slow-moving reference data (vendors).
                 Shipment is deliberately NOT cached: it changes every 5 minutes
                 and a stale ETA is worse than a database round trip. -->
            <!-- WildFly wires Hibernate's Infinispan region factory automatically
                 when second-level cache is enabled; no region.factory_class is
                 needed (and setting one breaks the integration). -->
            <property name="hibernate.cache.use_second_level_cache" value="true"/>
            <property name="hibernate.cache.use_query_cache"        value="true"/>

            <!-- JTA platform: WildFly. (Payara/GlassFish uses SunOneJtaPlatform.) -->
            <property name="hibernate.transaction.jta.platform"
                      value="org.hibernate.engine.transaction.jta.platform.internal.JBossAppServerJtaPlatform"/>

            <!-- Turn a silent in-memory pagination disaster into a loud failure. -->
            <property name="hibernate.query.fail_on_pagination_over_collection_fetch" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
