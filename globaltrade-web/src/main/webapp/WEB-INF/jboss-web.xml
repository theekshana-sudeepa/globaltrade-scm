<?xml version="1.0" encoding="UTF-8"?>
<!--
  WildFly-specific web descriptor.

  security-domain "other" is WildFly's default Elytron application security
  domain. Binding to it explicitly is what allows the custom Jakarta Security
  HttpAuthenticationMechanism (JwtAuthenticationMechanism) and IdentityStore
  (SupplyChainIdentityStore) to be invoked by Undertow.

  IMPORTANT: WildFly must also be told not to wrap the deployment in its own
  integrated JASPIC layer, or the custom mechanism is bypassed:

      /subsystem=undertow/application-security-domain=other:\
          write-attribute(name=integrated-jaspi,value=false)

  This single CLI line is the most common reason a Jakarta Security custom
  mechanism appears to "do nothing" on WildFly. It is applied by
  database/03-datasource-wildfly.sh.
-->
<jboss-web xmlns="http://www.jboss.com/xml/ns/javaee"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee
                               http://www.jboss.org/schema/jbossas/jboss-web_14_0.xsd"
           version="14.0">
    <context-root>/globaltrade</context-root>
    <security-domain>other</security-domain>
</jboss-web>
