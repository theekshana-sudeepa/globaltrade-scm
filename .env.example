# =====================================================================
# GlobalTrade SCM — Environment Configuration Template
# Copy this file to .env or export these variables in your shell environment.
# =====================================================================

# ---------------------------------------------------------------------
# Application Server (WildFly 31+ Full Profile / Payara 6)
# ---------------------------------------------------------------------
WILDFLY_HOME=/opt/wildfly-31.0.1.Final

# ---------------------------------------------------------------------
# Security & JWT Configuration
# Required: Must be at least 32 characters (256-bit cryptographic secret).
# Generate using: openssl rand -hex 32
# ---------------------------------------------------------------------
GT_JWT_SECRET=your_32_character_cryptographic_secret_key_here_minimum_len

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8.0+)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=globaltrade
DB_USER=globaltrade
DB_PASS=CHANGE_ME_TO_A_SECURE_PASSWORD

# ---------------------------------------------------------------------
# Admin / Demo Seed Credentials (For local testing & verification)
# ---------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@globaltrade.lk
DEFAULT_ADMIN_PASS=Passw0rd!2026
DEFAULT_VENDOR_EMAIL=rep@acme-supplies.com
DEFAULT_VENDOR_PASS=Passw0rd!2026
